\documentclass[
$if(classoption)$
$for(classoption)$
  $classoption$$sep$,
$endfor$,
$endif$
]{$documentclass$}

$if(biblatex)$
\usepackage[
$if(biblatexoptions)$
$for(biblatexoptions)$
  $biblatexoptions$$sep$,
$endfor$,
$endif$
]{biblatex}

\addbibresource{my_library.bib}

$endif$
$if(number-sections)$
$else$
\setcounter{secnumdepth}{-\maxdimen}

$endif$
$if(header-includes)$
$for(header-includes)$
$header-includes$
$endfor$

$endif$
$if(title)$
\title{$title$$if(thanks)$\thanks{$thanks$}$endif$}
$endif$
$if(author)$
\author{$for(author)$$author$$sep$ \and $endfor$}
$endif$
$if(date)$
\date{$date$}
$endif$

\begin{document}
$if(title)$
\maketitle

$if(abstract)$
\begin{abstract}
  $abstract$
\end{abstract}

$endif$
$endif$
$if(include-before)$
$for(include-before)$
$include-before$
$endfor$

$endif$
$body$
$if(biblatex)$
$if(suppress-bibliography)$
$else$

\printbibliography$if(biblio-title)$[title=$biblio-title$]$endif$
$endif$
$endif$
$if(include-after)$

$for(include-after)$
$include-after$
$endfor$
$endif$
\end{document}
